# VS Code launch configurations load .env. The CLI does not load dotenv files itself.
# Copy this file to .env if it does not exist, then fill in your API key.
DEEPSEEK_API_KEY=

# Optional: choose the model and API endpoint used by the CLI.
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
